{
  "extends": "@acme/tsconfig/base.json",
  "compilerOptions": {
    /* These compiler options are required by Convex */
    "target": "ESNext",
    "lib": ["ES2022", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@acme/backend/*": ["./convex/*"]
    }
  },
  "include": ["./**/*"],
  "exclude": ["node_modules/", "eslint.config.mjs", "legacy/"]
}
