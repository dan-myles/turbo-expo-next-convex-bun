{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@acme/ui",
  "private": true,
  "type": "module",
  "prettier": "@acme/prettier-config",
  "imports": {
    "#ui/*": "./src/*"
  },
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.tsx",
    "./lib/*": "./src/lib/*.tsx"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "echo 'NO TEST SUITE CONFIGURED'",
    "format": "prettier . --check --cache --cache-location .cache/.prettiercache --ignore-path ../../.prettierignore",
    "format:fix": "prettier . --write --cache --cache-location .cache/.prettiercache --ignore-path ../../.prettierignore",
    "lint": "eslint . --cache --cache-location .cache/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .cache/.eslintcache",
    "clean": "git clean -xdf dist node_modules .cache .turbo/cache"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "react": "catalog:react19",
    "react-day-picker": "^9.13.0",
    "react-dom": "catalog:react19",
    "react-hook-form": "^7.69.0",
    "react-resizable-panels": "^4.0.16",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:tailwind",
    "vaul": "^1.1.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@eslint/compat": "catalog:eslint",
    "@eslint/eslintrc": "catalog:eslint",
    "@ianvs/prettier-plugin-sort-imports": "catalog:prettier",
    "@prettier/plugin-oxc": "catalog:prettier",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "eslint": "catalog:eslint",
    "eslint-plugin-unused-imports": "catalog:eslint",
    "prettier": "catalog:prettier",
    "prettier-plugin-classnames": "catalog:prettier",
    "prettier-plugin-ember-template-tag": "catalog:prettier",
    "prettier-plugin-merge": "catalog:prettier",
    "prettier-plugin-tailwindcss": "catalog:prettier",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:eslint"
  }
}
