{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@acme/native",
  "main": "expo-router/entry",
  "private": true,
  "prettier": "@acme/prettier-config",
  "imports": {
    "#native/*": "./src/*",
    "#native/assets/*": "./assets/*",
    "#native/vendor/*": "./vendor/*"
  },
  "scripts": {
    "build": "eas build --platform ios --profile preview --local --non-interactive --output ./dist/.app-ios-preview.ipa",
    "dev": "expo start",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "echo 'NO TEST SUITE CONFIGURED'",
    "format": "prettier . --check --cache --cache-location .cache/.prettiercache --ignore-path ../../.prettierignore",
    "format:fix": "prettier . --write --cache --cache-location .cache/.prettiercache --ignore-path ../../.prettierignore",
    "lint": "eslint .  --cache --cache-location .cache/.eslintcache",
    "lint:fix": "eslint . --fix  --cache --cache-location .cache/.eslintcache",
    "clean": "git clean -xdf dist node_modules .turbo/cache .cache .expo android ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean --platform ios"
  },
  "dependencies": {
    "@acme/tailwind": "workspace:*",
    "@expo/vector-icons": "catalog:native",
    "@t3-oss/env-core": "catalog:",
    "@react-navigation/native": "catalog:native",
    "convex": "catalog:convex",
    "expo": "catalog:native",
    "zod": "catalog:",
    "uniwind": "catalog:tailwind",
    "expo-constants": "catalog:native",
    "expo-font": "catalog:native",
    "expo-linking": "catalog:native",
    "expo-router": "catalog:native",
    "expo-splash-screen": "catalog:native",
    "expo-status-bar": "catalog:native",
    "expo-web-browser": "catalog:native",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "catalog:native",
    "react-native-reanimated": "catalog:native",
    "react-native-safe-area-context": "catalog:native",
    "react-native-screens": "catalog:native",
    "react-native-web": "catalog:native",
    "react-native-worklets": "catalog:native"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@types/react": "catalog:react19",
    "typescript": "catalog:",
    "@eslint/compat": "catalog:eslint",
    "@eslint/eslintrc": "catalog:eslint",
    "eslint": "catalog:eslint",
    "eslint-plugin-react": "catalog:eslint",
    "eslint-plugin-react-hooks": "catalog:eslint",
    "eslint-plugin-expo": "catalog:eslint",
    "typescript-eslint": "catalog:eslint",
    "eslint-plugin-unused-imports": "catalog:eslint",
    "prettier": "catalog:prettier",
    "@ianvs/prettier-plugin-sort-imports": "catalog:prettier",
    "@prettier/plugin-oxc": "catalog:prettier",
    "prettier-plugin-classnames": "catalog:prettier",
    "prettier-plugin-ember-template-tag": "catalog:prettier",
    "prettier-plugin-merge": "catalog:prettier",
    "prettier-plugin-tailwindcss": "catalog:prettier"
  }
}
