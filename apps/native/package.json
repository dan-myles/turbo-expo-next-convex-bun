{
  "name": "@acme/native",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "build": "eas build --platform ios --profile preview --local --non-interactive --output ./dist/.app-ios-preview.ipa",
    "dev": "expo start",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "echo 'NO TEST SUITE CONFIGURED'",
    "format": "prettier . --check --cache --cache-location .cache/.prettiercache --ignore-path ../../.prettierignore",
    "format:fix": "prettier . --write --cache --cache-location .cache/.prettiercache --ignore-path ../../.prettierignore",
    "lint": "eslint .  --cache --cache-location .cache/.eslintcache",
    "lint:fix": "eslint . --fix  --cache --cache-location .cache/.eslintcache",
    "clean": "git clean -xdf dist node_modules .turbo/cache .cache .expo android ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean --platform ios"
  },
  "dependencies": {
    "@acme/tailwind": "workspace:*",
    "@expo/vector-icons": "^15.0.3",
    "@t3-oss/env-core": "catalog:",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.25",
    "uniwind": "catalog:tailwind",
    "expo-constants": "~18.0.10",
    "expo-font": "~14.0.9",
    "expo-linking": "~8.0.9",
    "expo-router": "~6.0.15",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.9",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@types/react": "catalog:react19",
    "typescript": "catalog:"
  }
}
