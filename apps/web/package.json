{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@acme/web",
  "private": true,
  "type": "module",
  "prettier": "@acme/prettier-config",
  "imports": {
    "#web/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite dev --port 3000",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "echo 'NO TEST SUITE CONFIGURED'",
    "format": "prettier . --check --cache --cache-location .cache/.prettiercache --ignore-path ../../.prettierignore",
    "format:fix": "prettier . --write --cache --cache-location .cache/.prettiercache --ignore-path ../../.prettierignore",
    "lint": "eslint .  --cache --cache-location .cache/.eslintcache",
    "lint:fix": "eslint . --fix  --cache --cache-location .cache/.eslintcache",
    "clean": "git clean -xdf dist node_modules .cache .tanstack .nitro .output"
  },
  "dependencies": {
    "@acme/tailwind": "workspace:*",
    "zod": "catalog:",
    "@t3-oss/env-core": "catalog:",
    "@tailwindcss/vite": "catalog:tailwind",
    "@tanstack/react-devtools": "catalog:tanstack",
    "@tanstack/react-query": "catalog:tanstack",
    "@tanstack/react-query-devtools": "catalog:tanstack",
    "@tanstack/react-router": "catalog:tanstack",
    "@tanstack/react-router-devtools": "catalog:tanstack",
    "@tanstack/react-router-ssr-query": "catalog:tanstack",
    "@tanstack/react-start": "catalog:tanstack",
    "@tanstack/router-plugin": "catalog:tanstack",
    "nitro": "catalog:tanstack",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "tailwindcss": "catalog:tailwind",
    "vite-tsconfig-paths": "catalog:vite"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@eslint/compat": "catalog:eslint",
    "@eslint/eslintrc": "catalog:eslint",
    "@ianvs/prettier-plugin-sort-imports": "catalog:prettier",
    "@prettier/plugin-oxc": "catalog:prettier",
    "@tanstack/devtools-vite": "catalog:tanstack",
    "@tanstack/eslint-config": "catalog:eslint",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitejs/plugin-react": "catalog:vite",
    "babel-plugin-react-compiler": "catalog:react19",
    "eslint": "catalog:eslint",
    "eslint-plugin-react": "catalog:eslint",
    "eslint-plugin-react-hooks": "catalog:eslint",
    "eslint-plugin-unused-imports": "catalog:eslint",
    "jsdom": "catalog:",
    "prettier": "catalog:prettier",
    "prettier-plugin-classnames": "catalog:prettier",
    "prettier-plugin-ember-template-tag": "catalog:prettier",
    "prettier-plugin-merge": "catalog:prettier",
    "prettier-plugin-tailwindcss": "catalog:prettier",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:eslint",
    "vite": "catalog:vite",
    "vitest": "catalog:vite",
    "web-vitals": "catalog:"
  }
}
