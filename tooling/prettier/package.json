{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@acme/prettier-config",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "prettier": "@acme/prettier-config",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "clean": "git clean -xdf dist node_modules .cache .turbo/cache"
  },
  "dependencies": {
    "@ianvs/prettier-plugin-sort-imports": "catalog:prettier",
    "@prettier/plugin-oxc": "catalog:prettier",
    "prettier": "catalog:prettier",
    "prettier-plugin-classnames": "catalog:prettier",
    "prettier-plugin-ember-template-tag": "catalog:prettier",
    "prettier-plugin-merge": "catalog:prettier",
    "prettier-plugin-tailwindcss": "catalog:prettier"
  },
  "devDependencies": {
    "@acme/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
