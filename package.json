{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@acme/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*",
      "scripts/"
    ],
    "catalog": {
      "@types/bun": "^1.3.3",
      "@types/node": "^22.13.4",
      "@t3-oss/env-core": "^0.13.10",
      "jsdom": "^27.4.0",
      "web-vitals": "^5.1.0",
      "neverthrow": "^8.2.0",
      "zod": "^4.2.1",
      "typescript": "^5.9.3"
    },
    "catalogs": {
      "native": {
        "expo": "~54.0.30",
        "expo-constants": "~18.0.12",
        "expo-font": "~14.0.10",
        "expo-linking": "~8.0.11",
        "expo-router": "~6.0.21",
        "expo-splash-screen": "~31.0.13",
        "expo-status-bar": "~3.0.9",
        "expo-web-browser": "~15.0.10",
        "@expo/vector-icons": "^15.0.3",
        "@react-navigation/native": "^7.1.8",
        "react-native": "0.81.5",
        "react-native-reanimated": "~4.1.1",
        "react-native-safe-area-context": "~5.6.0",
        "react-native-screens": "~4.16.0",
        "react-native-web": "~0.21.0",
        "react-native-worklets": "0.5.1",
        "react-native-gesture-handler": "^2.28.0",
        "react-native-svg": "15.12.1",
        "heroui-native": "^1.0.0-beta.9",
        "@gorhom/bottom-sheet": "^5"
      },
      "tanstack": {
        "@tanstack/react-devtools": "^0.9.0",
        "@tanstack/react-query": "^5.66.5",
        "@tanstack/react-query-devtools": "^5.84.2",
        "@tanstack/react-router": "^1.144.0",
        "@tanstack/react-router-devtools": "^1.144.0",
        "@tanstack/react-router-ssr-query": "^1.144.0",
        "@tanstack/react-start": "^1.145.0",
        "@tanstack/router-plugin": "^1.144.0",
        "@tanstack/devtools-vite": "^0.4.0",
        "nitro": "latest"
      },
      "vite": {
        "vite": "^7.3.0",
        "vitest": "^4.0.16",
        "@vitejs/plugin-react": "^5.1.2",
        "vite-tsconfig-paths": "^6.0.3"
      },
      "convex": {
        "convex": "^1.31.2",
        "convex-helpers": "^0.1.106",
        "zodvex": "^0.2.5",
        "@convex-dev/react-query": "^0.1.0"
      },
      "react19": {
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "@types/react": "19.1.10",
        "@types/react-dom": "19.1.0",
        "babel-plugin-react-compiler": "^1.0.0"
      },
      "tailwind": {
        "@tailwindcss/vite": "^4.1.18",
        "tailwindcss": "^4.1.18",
        "tailwind-merge": "^3.4.0",
        "tailwind-variants": "^3.2.2",
        "uniwind": "^1.2.2"
      },
      "prettier": {
        "prettier": "^3.7.4",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
        "@prettier/plugin-oxc": "^0.1.3",
        "prettier-plugin-classnames": "^0.8.6",
        "prettier-plugin-merge": "^0.8.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "prettier-plugin-ember-template-tag": "^2.1.2"
      },
      "eslint": {
        "eslint": "^9.39.2",
        "@eslint/compat": "^2.0.0",
        "@eslint/eslintrc": "^3.3.3",
        "@convex-dev/eslint-plugin": "^1.0.0",
        "@tanstack/eslint-config": "^0.3.0",
        "eslint-plugin-expo": "^1.0.0",
        "eslint-plugin-unused-imports": "^4.2.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "typescript-eslint": "^8.50.1"
      }
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@acme/web...",
    "dev:native": "turbo run dev --filter=@acme/native...",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:ws": "bunx sherif@latest",
    "lint:ws:fix": "bunx sherif@latest --fix",
    "clean": "bun scripts/clean",
    "clean:root": "git clean -xdf dist node_modules .cache .turbo/cache",
    "clean:ws": "turbo run clean",
    "ck": "turbo run typecheck test format lint && bun run lint:ws",
    "ck:fix": "turbo run format:fix lint:fix && bun run lint:ws:fix",
    "pr": "bun run ck:fix && bun run ck"
  },
  "devDependencies": {
    "turbo": "^2.7.2"
  }
}
