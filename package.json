{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@acme/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*",
      "scripts/"
    ],
    "catalog": {
      "@types/bun": "^1.3.3",
      "@types/node": "^22.13.4",
      "convex": "^1.29.3",
      "zod": "^4.1.13",
      "typescript": "^5.9.3"
    },
    "catalogs": {
      "react19": {
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "@types/react": "19.1.0",
        "@types/react-dom": "19.1.0"
      },
      "prettier": {
        "prettier": "^3.7.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
        "@prettier/plugin-oxc": "^0.1.1",
        "prettier-plugin-classnames": "^0.8.5",
        "prettier-plugin-merge": "^0.8.0",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "prettier-plugin-ember-template-tag": "^2.1.0"
      },
      "eslint": {
        "eslint": "^9.39.1",
        "@eslint/compat": "^2.0.0",
        "@eslint/eslintrc": "^3.3.3",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "typescript-eslint": "^8.48.0"
      }
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@acme/web...",
    "dev:native": "turbo run dev --filter=@acme/native...",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:ws": "bunx sherif@latest",
    "lint:ws:fix": "bunx sherif@latest --fix",
    "clean": "bun scripts/clean",
    "clean:root": "git clean -xdf dist node_modules .cache .turbo/cache",
    "clean:ws": "turbo run clean",
    "ck": "turbo run typecheck test format lint && bun run lint:ws",
    "ck:fix": "turbo run format:fix lint:fix && bun run lint:ws:fix",
    "pr": "bun run ck:fix && bun run ck"
  },
  "devDependencies": {
    "turbo": "^2.6.2"
  }
}
